<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>data_recorder</name>
  <version>0.1.0</version>
  <description>Qt/QML UI prototype for ROS 2 data recording workflows.</description>
  <maintainer email="nros@example.com">nros</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>rosbag2_transport</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>ffmpeg</depend>
  <depend>qt6-base-dev</depend>
  <depend>qt6-declarative-dev</depend>
  <exec_depend>qml6-module-qtqml</exec_depend>
  <exec_depend>qml6-module-qtqml-models</exec_depend>
  <exec_depend>qml6-module-qtqml-workerscript</exec_depend>
  <exec_depend>qml6-module-qtquick</exec_depend>
  <exec_depend>qml6-module-qtquick-controls</exec_depend>
  <exec_depend>qml6-module-qtquick-layouts</exec_depend>
  <exec_depend>qml6-module-qtquick-templates</exec_depend>
  <exec_depend>qml6-module-qtquick-window</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>std_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
